rule merge_bams:
    """
    Merge 'keep' BAM files from mapping steps 1 and 2,
    then sort and index
    """
    input:
        keep1=config['results']+'/find_intersecting_snps/{sample}.keep.bam',
        keep2=config['results']+'/filter_remapped_reads/{sample}.keep.bam'
    threads: 2 
    params: 
        dir=config['results']+'/merge',
        sam='/cluster/ifs/users/narisu/anaconda/envs/ame/bin/samtools'
    output:
        merge=temp(config['results']+'/merge/{sample}.keep.merge.bam'),
        sort=temp(config['results']+'/merge/{sample}.keep.merge.sort.bam'),
        bai=temp(config['results']+'/merge/{sample}.keep.merge.sort.bam.bai')
    shell:
        'mkdir -p {params.dir}/{wildcards.sample}; '
        '{params.sam} merge {output.merge} {input.keep1} {input.keep2}; '
        '{params.sam} sort -m 10G -@ {threads} -T  {params.dir}/{wildcards.sample}/tmp -o {output.sort} {output.merge}; '
        '{params.sam} index {output.sort}'
    
