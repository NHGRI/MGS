def read_samples(file=None):
    """
    Function to get sample names from a specified
    in the configuration. Input file is expected to have 1
    column of sample ids with no header.
    """
    if file == None:
        file=config['data']+'/meta/subjects.txt'
    f = open(file, "r")
    samp_dict = {}
    for line in f:
        words = line.strip().split()
        samp_dict[words[0]] = words[0]
    return samp_dict

