    params:
        subset="/home/pchines/bin/vcf_subset.pl",
    output:
        hets=config['results']+'/heterozygotes/{sample}.hets',
    shell:
        "gzip -dc {input.txt_counts} | "
        'perl -lane \'print join("\t", @F[0..1], "$F[0]:$F[1]", @F[2..3,5,6],$F[5]+$F[6], 0, 0, 0, 0, 0) if /0\|1/ || /1\|0/;BEGIN{{print join("\t", qw(contig position variantID refAllele altAllele refCount altCount totalCount lowMAPQDepth lowBaseQDepth rawDepth otherBases improperPairs))}}\' > {output.hets}; ' 

