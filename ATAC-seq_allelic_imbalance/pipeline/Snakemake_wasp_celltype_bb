rule SNPs_in_ATAC_peaks_prepare_stouffer:
    """
    Generate input for stouffer test for sampes of interest.
    """
    input:
        expand(config['results']+'/ATAC_peak_SNPs_betabinomial/ATAC_peak_SNPs_{sample}.bed',
               sample=read_samples().keys()),
        script=config['prepare'],
    params:
        dir=config['results'],
        count_samples=2,
        total_read=6
    output:
        samples=config['results']+'/ATAC_peak_SNPs_betabinomial/sample_credible.samples',
        stouffer=config['results']+'/ATAC_peak_SNPs_stouffer_input_betabinom.txt',
    shell:
        'for i in {params.dir}/ATAC_peak_SNPs_betabinomial/ATAC_peak_SNPs*bed; do export dir=$i; '
        'perl -lane \'$dir=$ENV{{dir}}; $s++; $dir =~ s/.*\/ATAC_peak_SNPs_//; $dir=~s/\.bed$//; print $dir if $s>0\' $i | uniq ; done > {output.samples}; '
        'export dir={params.dir}; '
        "string=$(grep -vE \'EndoC|ABE1388.sp\' {output.samples} | "
        'perl -ne \'chomp; ; $d=$ENV{{dir}}; print "$d/ATAC_peak_SNPs_betabinomial/ATAC_peak_SNPs_$_".".bed "\'); '
        "perl -I /usr/local/gtb/lib/perl5 {input.script} -count {params.count_samples} -read {params.total_read}  $string "
        "> {output.stouffer}; "

