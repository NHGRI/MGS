rule SNPs_in_ATAC_peaks_credible_stouffer_T2D:
    """
    Stouffer test for SNPs in ATAC peaks. 
    """
    input:
        stouffer=config['results']+'/ATAC_peak_SNPs_stouffer_allelic_imbalance_betabinom.txt',
        credible='/cluster/ifs/users/narisu/github/gwas_database/credible_set_of_SNPs/data/T2D_trans_ancestry_Mahajan_et_al_2022_GRCh38.bed',
    params:
        bedtools='/home/pchines/bin/bedtools',
    output:
        stouffer=config['results']+'/ATAC_peak_SNPs_stouffer_allelic_imbalance_betabinom_T2D.txt',
    shell:
        'head -1 {input.stouffer} > {output}; '
        '{params.bedtools} intersect -wao -a {input.stouffer} -b {input.credible} | '
        'perl -lane \'@F=split(/\\t/); $F[3] = $F[18]; '
        'print join("\\t", @F[0..14]) if $F[15] ne "." && $F[1] eq $F[16] && $F[2] eq $F[17] \' | sort | uniq >> {output}; '

