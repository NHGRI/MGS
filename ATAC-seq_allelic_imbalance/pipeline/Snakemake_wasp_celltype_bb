        config['results']+'/combined_narrow_peaks/combined_narrow_peaks.bed'
    shell:
        # get bed files
        'bed=$(for i in `cat {input.sample}`; do ls {params.dir}/${{i}}_peaks.narrowPeak.noblacklist ; done | '
