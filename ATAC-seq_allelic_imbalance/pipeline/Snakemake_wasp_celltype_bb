rule rmdup_pe:
    """
    Remove duplicate read pairs.
    """
    input:
        config['results']+'/merge/{sample}.keep.merge.sort.bam'
    threads: 2 
    params:
        python='/cluster/ifs/users/narisu/anaconda/envs/ame/bin/python',
        dir=config['results']+'/rmdup',
        sam='/cluster/ifs/users/narisu/anaconda/envs/ame/bin/samtools',
    output:
        rmdup=temp(config['results']+'/rmdup/{sample}.keep.merge.rmdup.bam'),
        sort=temp(config['results']+'/rmdup/{sample}.keep.merge.rmdup.sort.bam')
    shell:
        'mkdir -p {params.dir}/{wildcards.sample};' 
        '{params.python} {WASP}/mapping/rmdup_pe.py {input} {output.rmdup} ;'
        '{params.sam} sort -m 4G -@ {threads} -T  {params.dir}/{wildcards.sample}/tmp -o {output.sort} {output.rmdup}; '
        '{params.sam} index {output.sort}'
        
rule clipoverlap:
    """
    Remove one copy of overlapping read pairs using bamUtil (https://github.com/statgen/bamUtil).
    """
    input:
        config['results']+'/rmdup/{sample}.keep.merge.rmdup.sort.bam'
    threads: 2 
    params:
        dir=config['results']+'/clip',
        python='/cluster/ifs/users/narisu/anaconda/envs/ame/bin/python',
        clip='/cluster/ifs/users/narisu/anaconda/envs/bamutil/bin/bam'
    output:
        clip=temp(config['results']+'/clip/{sample}.keep.merge.rmdup.bam'),
        sort=config['results']+'/clip/{sample}.keep.merge.rmdup.sort.bam'
    shell:
        'mkdir -p {params.dir}/{wildcards.sample};' 
        '{params.clip} clipOverlap --in {input} --out {output.clip}; '
        'samtools sort -m 4G -@ {threads} -T  {params.dir}/{wildcards.sample}/tmp -o {output.sort} {output.clip}; '
        'samtools index {output.sort}'
        
