rule vcf2h5:
    """ 
    Convert VCF data files to HDF5 format using WASP tool (https://github.com/bmvdgeijn/WASP). 
    VCF file has heterozygous imputed genotypes of the subjects. Imputation/sequencing based genotypes 
    of all samples of interest in vcf format is/are required.
    """
    input:
        config['data'] + '/genotypes/chr11.het.vcf.gz',
        chrom=config['chrom_info'],
    params:
        vcfs=config['data'] + '/genotypes/chr*.het.vcf.gz ',
    output:
        snp_index=config['snph5'] + '/snp_index.h5',
        snp_tab=config['snph5'] + '/snp_tab.h5',
        haplotype=config['snph5'] + '/haplotypes.h5'
    shell:
        '{WASP}/snp2h5/snp2h5 '
        '  --chrom {input.chrom} '
        '  --format vcf '
        '  --snp_index {output.snp_index} '
        '  --snp_tab {output.snp_tab} '
        '  --haplotype {output.haplotype} '
        '  {params.vcfs}'

rule find_intersecting_snps_paired_end:
    """
    Find intersecting SNPs using WASP script. A required reference genome aligned ATAC-seq 
    read bam files, one per sample of interest are required.      
    """
    resources:
        mem_mb=10000
    input:
        snp_index=config['snph5']+'/snp_index.h5',
        snp_tab=config['snph5']+'/snp_tab.h5',
        haplotype=config['snph5']+'/haplotypes.h5',
        sample=config['data']+'/meta/subjects.txt',
        bam=config['data']+'/subject_bam/{sample}.bam',
    params:
        python='/cluster/ifs/users/narisu/anaconda/envs/ame/bin/python',
        prefix=config['results']+'/find_intersecting_snps'
    output:
        fq1=temp(config['results']+'/find_intersecting_snps/{sample}.remap.fq1.gz'),
        fq2=temp(config['results']+'/find_intersecting_snps/{sample}.remap.fq2.gz'),
        keep_bam=temp(config['results']+'/find_intersecting_snps/{sample}.keep.bam'),
        remap_bam=temp(config['results']+'/find_intersecting_snps/{sample}.to.remap.bam')
    shell:
         '{params.python} {WASP}/mapping/find_intersecting_snps.py '
             '--is_paired_end '
             '--is_sorted '
             '--output_dir {params.prefix} '
             '--snp_tab {input.snp_tab} '
             '--snp_index {input.snp_index} '
             '--haplotype {input.haplotype} '
             '--samples {input.sample} '
             '{input.bam}'
         
rule map_bwa_paired_end2:
    """
    Map reads a second time using bwa (https://bio-bwa.sourceforge.net/bwa.shtml).
    """
    input:
        fq1=config['results']+'/find_intersecting_snps/{sample}.remap.fq1.gz',
        fq2=config['results']+'/find_intersecting_snps/{sample}.remap.fq2.gz',
        keep_bam=config['results']+'/find_intersecting_snps/{sample}.keep.bam',
        remap_bam=config['results']+'/find_intersecting_snps/{sample}.to.remap.bam'
    params:
        bwa='/home/narisu/bin/bwa',
        sam='/cluster/ifs/users/narisu/anaconda/envs/ame/bin/samtools',
        prefix=config['results']+'/map2/',
    threads: 2 
    resources:
        mem_mb=20000
    output:
        bai=temp(config['results']+'/map2/{sample}.bai'),
        bam=temp(config['results']+'/map2/{sample}.bam'),
    shell:
        'mkdir -p {params.prefix}; '
        '{params.bwa} mem -M -t {threads} {GENOME} {input.fq1} {input.fq2} | '
            '{params.sam} view -Suh -q 30 -F3840  | '
            '{params.sam} sort -O bam -T {params.prefix}/{wildcards.sample} '
            '-@ {threads} -m 2818572288 -> {output.bam}; '
            '{params.sam} index {output.bam} {output.bai}; '

