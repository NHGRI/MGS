            '--alt_as_counts {params.alt_as} '
            '--other_as_counts {params.other_as} '
            '--read_counts {params.read_counts} '
            '--txt_counts {output.txt_counts} '
            '{input.bam};'
        # clean uncessary files
        'rm {params.ref_as} {params.alt_as} {params.other_as} {params.read_counts}; '

